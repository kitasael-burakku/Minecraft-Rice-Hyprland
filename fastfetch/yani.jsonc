{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/fastfetchlogo/Yani-Neko.png",
    "type": "kitty-direct",
    "width": 45,
    "height": 18,
    "padding": {
      "top":1
    }
  },

  "display": {
    "separator": " --> "
  },

  "modules": [
    
    {
      "type": "custom",
      "format": "ヤニねこ",

      "key": "Chainsmoker cat"
    },
    
    {
      "type": "command",
      "key":  "󰌢 User",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    
    "break",
    
    {
      "type": "os",
      "key":    "OS",
      "format": "{pretty-name} {#60}[{arch}]"
    },
    
    {
      "type": "kernel",
      "key":    "{#244}├╮ (. ❛ ᴗ ❛.) Kernel",
      "format": "{sysname} {#60}[v{release}]"
    },
    
    {
      "type": "packages",
      "key":    "{#244}├󰏖 Packages",
      "format": "{all}"
    },
    
    {
      "type": "shell",
      "key":    "{#244}└➤ Shell",
      "format": "{pretty-name} {#60}[v{version}]"
    },
    
    "break",
    
    {
      "type": "wm",
      "key":    "󱂬 WM",
      "format": "{pretty-name}"
    },
    
    {
      "type": "terminal",
      "key":    "{#244}├_⿻🗖 Terminal",
      "format": "{pretty-name}  {#60}[{version}]"
    },
    
    {
      "type": "terminalfont",
      "key":    "{#244}├🗒 Font",
      "format": "{name}  {#60}[{size}]"
    },
    
    {
      "type": "wallpaper",
      "key":    "{#244}└󰸉 Wallpaper"
    },
    
    "break",
    
    {
      "type": "host",
      "key":    "󰌢 Cigarettes ᝰ🚬 ( ≖‿  ≖ )"
    },
    
    {
      "type": "cpu",
      "key":    "{#244}├󰻠 CPU",
      "showPeCoreCount": true,
      "temp": true,
      "format": "{name}  {#60}[{core-types}] [{freq-max}]"
    },
    
    {
      "type": "gpu",
      "key":    "{#244}├󰍛 GPU",
      "detectionMethod": "auto",
      "driverSpecific": false,
      "format": "{vendor} {name}"
    },
    
    {
      "type": "memory",
      "key":    "{#244}├󰑭 Memory",
      "format": "{used} / {total}  {#60}({percentage})"
    },

    {
      "type": "disk",
      "key":    "{#71}├🖴 Disk",
      "format": "{size-used} / {size-total}  {#65}({size-percentage})"
    },

    {
      "type": "uptime",
      "key":    "{#244}└󰅐 Should I smoke now? ᝰ🚬 ( ≖‿  ≖ )",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    
    "break",
    
    {
      "type": "colors",
      "symbol": "circle"
    },

    "break"
  ]
}