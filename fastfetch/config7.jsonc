// HyprMc · Fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "~/.config/fastfetch/fastfetchlogo/HyprMc.png", "type": "kitty-direct", "width": 45, "height": 20},
  "display": { "separator": " ⛏ " },

  "modules": [
    {
      "type": "custom",
      "format": "{#114}― Diamonds & Dotfiles ―"
    },
    "break",
    {
      "type": "command",
      "key":  "{#114}Player",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    {
      "type": "command",
      "key":  "{#114}󰌢 World",
      "text": "hostnamectl --pretty 2>/dev/null || hostname",
      "format": "{result}"
    },
    "break",
    {
      "type": "os",
      "key":    "{#114} OS",
      "format": "{pretty-name}  {#65}[{arch}]"
    },
    {
      "type": "kernel",
      "key":    "{#71}├ Kernel",
      "format": "{sysname}  {#65}[v{release}]"
    },
    {
      "type": "packages",
      "key":    "{#71}├󰏖 Packages",
      "format": "{all}"
    },
    {
      "type": "shell",
      "key":    "{#71}└ Shell",
      "format": "{pretty-name}  {#65}[v{version}]"
    },
    "break",
    {
      "type": "wm",
      "key":    "{#114}󱂬 WM",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key":    "{#71}├ Terminal",
      "format": "{pretty-name}  {#65}[{version}]"
    },
    {
      "type": "terminalfont",
      "key":    "{#71}├ Font",
      "format": "{name}  {#65}[{size}]"
    },
    {
      "type": "wallpaper",
      "key":    "{#71}└󰸉 Wallpaper"
    },
    "break",
    {
      "type": "host",
      "key":    "{#114}󰌢 Base"
    },
    {
      "type": "cpu",
      "key":    "{#71}├󰻠 Redstone",
      "showPeCoreCount": true,
      "temp": true,
      "format": "{name}  {#65}[{core-types}] [{freq-max}]"
    },
    {
      "type": "gpu",
      "key":    "{#244}├󰍛 Render",
      "detectionMethod": "auto",
      "driverSpecific": false,
      "format": "{vendor} {name}"
    },
    {
      "type": "memory",
      "key":    "{#71}├󰑭 Inventory",
      "format": "{used} / {total}  {#65}({percentage})"
    },
    {
      "type": "disk",
      "key":    "{#71}├ Chest",
      "format": "{size-used} / {size-total}  {#65}({size-percentage})"
    },
    {
      "type": "uptime",
      "key":    "{#71}└󰅐 Playtime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
