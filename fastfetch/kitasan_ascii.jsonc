// Kitasan Black (ASCII) · Fastfetch · Banner
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "color": { "keys": "33" }
  },
  "logo": { "type": "none" },
  "modules": [
    {
      "type": "custom",
      "format": "{#33}██╗  ██╗██╗████████╗ █████╗ ███████╗ █████╗ ███╗   ██╗\n{#93}██║ ██╔╝██║╚══██╔══╝██╔══██╗██╔════╝██╔══██╗████╗  ██║\n{#33}█████╔╝ ██║   ██║   ███████║███████╗███████║██╔██╗ ██║\n{#93}██╔═██╗ ██║   ██║   ██╔══██║╚════██║██╔══██║██║╚██╗██║\n{#33}██║  ██╗██║   ██║   ██║  ██║███████║██║  ██║██║ ╚████║\n{#93}╚═╝  ╚═╝╚═╝   ╚═╝   ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝╚═╝  ╚═══╝\n{#33}██████╗ ██╗      █████╗  ██████╗██╗  ██╗\n{#93}██╔══██╗██║     ██╔══██╗██╔════╝██║ ██╔╝\n{#33}██████╔╝██║     ███████║██║     █████╔╝\n{#93}██╔══██╗██║     ██╔══██║██║     ██╔═██╗\n{#33}██████╔╝███████╗██║  ██║╚██████╗██║  ██╗\n{#93}╚═════╝ ╚══════╝╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝"
    },
    "break",
    { "type": "title", "key": "{#33}Trainer", "format": "{user-name}" },
    "break",
    { "type": "os", "key": "{#33} OS", "format": "{pretty-name}  {#94}[{arch}]" },
    { "type": "kernel", "key": "{#136}├ Kernel", "format": "{sysname}  {#94}[v{release}]" },
    { "type": "shell", "key": "{#136}├ Shell", "format": "{pretty-name}" },
    { "type": "wm", "key": "{#136}└ WM", "format": "{pretty-name}" },
    "break",
    { "type": "cpu", "key": "{#33}󰻠 Power", "temp": true, "format": "{name}" },
    { "type": "gpu", "key": "{#136}├󰍛 Speed", "detectionMethod": "auto", "driverSpecific": false, "format": "{name}" },
    { "type": "memory", "key": "{#136}├󰑭 Wisdom" },
    { "type": "disk", "key": "{#136}├ Stamina", "folders": "/" },
    { "type": "uptime", "key": "{#136}└󰅐 Guts" },
    "break"
  ]
}
