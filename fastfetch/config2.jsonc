{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "~/.config/fastfetch/fastfetchlogo/goldship.png", "type": "kitty-direct", "width": 45, "height": 20},
  "display": { "separator": " → " },

  "modules": [
    {
      "type": "command",
      "key":  "{#141}User",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    {
      "type": "command",
      "key":  "{#141}󰌢 Host",
      "text": "hostnamectl --pretty 2>/dev/null || hostname",
      "format": "{result}"
    },
    "break",
    {
      "type": "os",
      "key":    "{#141} OS",
      "format": "{pretty-name}  {#60}[{arch}]"
    },
    {
      "type": "kernel",
      "key":    "{#183}├ Kernel",
      "format": "{sysname}  {#60}[v{release}]"
    },
    {
      "type": "packages",
      "key":    "{#183}├󰏖 Packages",
      "format": "{all}"
    },
    {
      "type": "shell",
      "key":    "{#183}└ Shell",
      "format": "{pretty-name}  {#60}[v{version}]"
    },
    "break",
    {
      "type": "wm",
      "key":    "{#141}󱂬 WM",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key":    "{#183}├ Terminal",
      "format": "{pretty-name}  {#60}[{version}]"
    },
    {
      "type": "terminalfont",
      "key":    "{#183}├ Font",
      "format": "{name}  {#60}[{size}]"
    },
    {
      "type": "wallpaper",
      "key":    "{#183}└󰸉 Wallpaper"
    },
    "break",
    {
      "type": "host",
      "key":    "{#141}󰌢 PC"
    },
    {
      "type": "cpu",
      "key":    "{#183}├󰻠 CPU",
      "showPeCoreCount": true,
      "temp": true,
      "format": "{name}  {#60}[{core-types}] [{freq-max}]"
    },
    {
      "type": "gpu",
      "key":    "{#244}├󰍛 GPU",
      "detectionMethod": "auto",
      "driverSpecific": false,
      "format": "{vendor} {name}"
    },
    {
      "type": "memory",
      "key":    "{#183}├󰑭 Memory",
      "format": "{used} / {total}  {#60}({percentage})"
    },
    {
      "type": "disk",
      "key":    "{#183}├ Disk",
      "format": "{size-used} / {size-total}  {#60}({size-percentage})"
    },
    {
      "type": "uptime",
      "key":    "{#183}└󰅐 Uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
