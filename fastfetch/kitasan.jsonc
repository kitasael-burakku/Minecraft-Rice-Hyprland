// Kitasan Black · Fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  
  "logo": { 
    "source": "~/.config/fastfetch/fastfetchlogo/kitasan.png", 
    "type": "kitty-direct",
    "width": 30, 
    "height": 18
  },


  "display": {
    "separator": " ➜ "
  },

  
  "modules": [
    
    {
      "type": "custom",
      "format": "キタサンブラック",

      "key": "Elegant Front Runner ฅ^>⩊<^ ฅ"
    },

    {
      "type": "command",
      "key":  "ִֶָ🪽་༘ Trainer",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    
    {
      "type": "command",
      "key":  "󰌢 Stable",
      "text": "hostnamectl --pretty 2>/dev/null || hostname",
      "format": "{result}"
    },
    
    "break",
    
    {
      "type": "os",
      "key":    "OS",
      "format": "{pretty-name}  {#60}[{arch}]"
    },
    
    {
      "type": "kernel",
      "key":    "{#244}├🖥️ Kernel",
      "format": "{sysname}  {#60}[v{release}]"
    },
    
    {
      "type": "packages",
      "key":    "{#244}├󰏖 Packages",
      "format": "{all}"
    },
    
    {
      "type": "shell",
      "key":    "{#244}└𑣲⋆ Shell",
      "format": "{pretty-name}  {#60}[v{version}]"
    },
    
    "break",
    
    {
      "type": "wm",
      "key":    "󱂬 WM",
      "format": "{pretty-name}"
    },
    
    {
      "type": "terminal",
      "key":    "{#244}├ᯓ➤ Terminal",
      "format": "{pretty-name}  {#60}[{version}]"
    },
    
    {
      "type": "terminalfont",
      "key":    "{#244}├🗁 Font",
      "format": "{name}  {#60}[{size}]"
    },
    
    {
      "type": "wallpaper",
      "key":    "{#244}└󰸉 Wallpaper"
    },
    
    "break",
    
    {
      "type": "host",
      "key":    "󰌢 Components"
    },
    
    {
      "type": "cpu",
      "key":    "{#244}├󰻠 Power",
      "showPeCoreCount": true,
      "temp": true,
      "format": "{name}  {#60}[{core-types}] [{freq-max}]"
    },
    
    {
      "type": "gpu",
      "key":    "{#244}├󰍛 Speed",
      "detectionMethod": "auto",
      "driverSpecific": false,
      "format": "{vendor} {name}"
    },
    
    {
      "type": "memory",
      "key":    "{#244}├󰑭 Wisdom",
      "format": "{used} / {total}  {#60}({percentage})"
    },

    {
      "type": "disk",
      "key":    "{#71}├🖴 Wit",
      "format": "{size-used} / {size-total}  {#65}({size-percentage})"
    },

    {
      "type": "uptime",
      "key":    "{#244}└󰅐 Guts",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    
    "break",
    
    {
      "type": "colors",
      "symbol": "circle"
    },

    "break"
  ]
}

