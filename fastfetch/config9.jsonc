{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " → ",
    "color": { "keys": "red" }
  },
  "logo": { "type": "none" },
  "modules": [
    {
      "type": "custom",
      "format": "{#31}██████╗ ██╗   ██╗██╗  ██╗██╗\n{#31}██╔══██╗██║   ██║██║ ██╔╝██║\n{#91}██║  ██║██║   ██║█████╔╝ ██║\n{#91}██║  ██║██║   ██║██╔═██╗ ██║\n{#31}██████╔╝╚██████╔╝██║  ██╗██║\n{#31}╚═════╝  ╚═════╝ ╚═╝  ╚═╝╚═╝\n{#90}          • 𝘔𝘰𝘥𝘰 𝘋𝘪𝘢𝘣𝘭𝘰 • 𖤐 𖤐"
    },
    "break",
    {
      "type": "command",
      "key":  "{#31} User",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    {
      "type": "command",
      "key":  "{#31}󰌢 Host",
      "text": "hostnamectl --pretty 2>/dev/null || hostname",
      "format": "{result}"
    },
    "break",
    {
      "type": "os",
      "key":    "{#31} OS",
      "format": "{pretty-name}  {#88}[{arch}]"
    },
    {
      "type": "kernel",
      "key":    "{#91}├ Kernel",
      "format": "{sysname}  {#88}[v{release}]"
    },
    {
      "type": "shell",
      "key":    "{#91}└ Shell",
      "format": "{pretty-name}  {#88}[v{version}]"
    },
    "break",
    {
      "type": "cpu",
      "key":    "{#31}󰻠 CPU",
      "temp": true,
      "format": "{name}  {#88}[{freq-max}]"
    },
    {
      "type": "memory",
      "key":    "{#91}├󰑭 Memory",
      "format": "{used} / {total}  {#88}({percentage})"
    },
    {
      "type": "uptime",
      "key":    "{#91}└󰅐 Uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    }
  ]
}