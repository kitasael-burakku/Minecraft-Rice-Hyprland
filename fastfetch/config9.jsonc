{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "display": {
    "separator": " → ",
    "color": {
      "keys": "red",
      "title": "red"
    }
  },

  "logo": {
    "type": "none"
  },

  "modules": [
    {
      "type": "custom",
      "format": "{#31}██████╗ ██╗   ██╗██╗  ██╗██╗\n{#31}██╔══██╗██║   ██║██║ ██╔╝██║\n{#91}██║  ██║██║   ██║█████╔╝ ██║\n{#91}██║  ██║██║   ██║██╔═██╗ ██║\n{#31}██████╔╝╚██████╔╝██║  ██╗██║\n{#31}╚═════╝  ╚═════╝ ╚═╝  ╚═╝╚═╝\n{#90}          • 𝘔𝘰𝘥𝘰 𝘋𝘪𝘢𝘣𝘭𝘰 • 𖤐 𖤐"
    },
    "break",

    {
      "type": "command",
      "key": "{#33}User",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    {
      "type": "command",
      "key": "{#33}󰌢 Host",
      "text": "hostnamectl --pretty 2>/dev/null || hostname",
      "format": "{result}"
    },

    "break",

    {
      "type": "os",
      "key": "{#93} OS",
      "format": "{pretty-name} [{arch}]"
    },
    {
      "type": "kernel",
      "key": "{#93}├ Kernel",
      "format": "{sysname} [v{release}]"
    },
    {
      "type": "shell",
      "key": "{#93}└ Shell",
      "format": "{pretty-name} [v{version}]"
    },

    "break",

    {
      "type": "cpu",
      "key": "{#91}󰻠 CPU",
      "temp": true,
      "format": "{name} [{freq-max}]"
    },
    {
      "type": "memory",
      "key": "{#91}󰑭 Memory",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "uptime",
      "key": "{#91}󰅐 Uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    }
  ]
}