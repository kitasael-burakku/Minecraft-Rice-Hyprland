// Arch Linux · Fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "arch", "type": "builtin"},
  "display": { "separator": " :: " },

  "modules": [
    {
      "type": "custom",
      "format": "{#75}― I use Arch btw ―"
    },
    "break",
    {
      "type": "command",
      "key":  "{#75}User",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    {
      "type": "command",
      "key":  "{#75}󰌢 Host",
      "text": "hostnamectl --pretty 2>/dev/null || hostname",
      "format": "{result}"
    },
    "break",
    {
      "type": "os",
      "key":    "{#75} OS",
      "format": "{pretty-name}  {#60}[{arch}]"
    },
    {
      "type": "kernel",
      "key":    "{#111}├ Kernel",
      "format": "{sysname}  {#60}[v{release}]"
    },
    {
      "type": "packages",
      "key":    "{#111}├󰏖 Pacman",
      "format": "{pacman}"
    },
    {
      "type": "shell",
      "key":    "{#111}└ Shell",
      "format": "{pretty-name}  {#60}[v{version}]"
    },
    "break",
    {
      "type": "wm",
      "key":    "{#75}󱂬 WM",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key":    "{#111}├ Terminal",
      "format": "{pretty-name}  {#60}[{version}]"
    },
    {
      "type": "terminalfont",
      "key":    "{#111}├ Font",
      "format": "{name}  {#60}[{size}]"
    },
    {
      "type": "wallpaper",
      "key":    "{#111}└󰸉 Wallpaper"
    },
    "break",
    {
      "type": "host",
      "key":    "{#75}󰌢 PC"
    },
    {
      "type": "cpu",
      "key":    "{#111}├󰻠 CPU",
      "showPeCoreCount": true,
      "temp": true,
      "format": "{name}  {#60}[{core-types}] [{freq-max}]"
    },
    {
      "type": "gpu",
      "key":    "{#244}├󰍛 GPU",
      "detectionMethod": "auto",
      "driverSpecific": false,
      "format": "{vendor} {name}"
    },
    {
      "type": "memory",
      "key":    "{#111}├󰑭 Memory",
      "format": "{used} / {total}  {#60}({percentage})"
    },
    {
      "type": "disk",
      "key":    "{#111}├ Disk",
      "format": "{size-used} / {size-total}  {#60}({size-percentage})"
    },
    {
      "type": "uptime",
      "key":    "{#111}└󰅐 Uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
