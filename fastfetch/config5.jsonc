{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "lfs", "type": "builtin", "padding": { "top": 1, "left": 1 } },
  "display": { "separator": " → " },

  "modules": [
    {
      "type": "command",
      "key":  "{#74} User",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    {
      "type": "command",
      "key":  "{#74}󰌢 Host",
      "text": "hostnamectl --pretty 2>/dev/null || hostname",
      "format": "{result}"
    },
    "break",
    {
      "type": "os",
      "key":    "{#74} OS",
      "format": "{pretty-name}  {#24}[{arch}]"
    },
    {
      "type": "kernel",
      "key":    "{#110}├ Kernel",
      "format": "{sysname}  {#24}[v{release}]"
    },
    {
      "type": "packages",
      "key":    "{#110}├󰏖 Packages",
      "format": "{all}"
    },
    {
      "type": "shell",
      "key":    "{#110}└ Shell",
      "format": "{pretty-name}  {#24}[v{version}]"
    },
    "break",
    {
      "type": "wm",
      "key":    "{#74}󱂬 WM",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key":    "{#110}├ Terminal",
      "format": "{pretty-name}  {#24}[{version}]"
    },
    {
      "type": "terminalfont",
      "key":    "{#110}├ Font",
      "format": "{name}  {#24}[{size}]"
    },
    {
      "type": "wallpaper",
      "key":    "{#110}└󰸉 Wallpaper"
    },
    "break",
    {
      "type": "host",
      "key":    "{#74}󰌢 PC"
    },
    {
      "type": "cpu",
      "key":    "{#110}├󰻠 CPU",
      "showPeCoreCount": true,
      "temp": true,
      "format": "{name}  {#24}[{core-types}] [{freq-max}]"
    },
    {
      "type": "gpu",
      "key":    "{#110}├󰍛 GPU",
      "detectionMethod": "auto",
      "driverSpecific": true,
      "format": "Radeon RX 7600  {#24}[{type}]"
    },
    {
      "type": "memory",
      "key":    "{#110}├󰑭 Memory",
      "format": "{used} / {total}  {#24}({percentage})"
    },
    {
      "type": "disk",
      "key":    "{#110}├ Disk",
      "format": "{size-used} / {size-total}  {#24}({size-percentage})"
    },
    {
      "type": "uptime",
      "key":    "{#110}└󰅐 Uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
