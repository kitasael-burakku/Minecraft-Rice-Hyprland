{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "lfs", "type": "builtin", "padding": { "top": 1, "left": 1 } },
  "display": {
    "separator": " → ",
    "color": {
      "keys":   "white",
      "output": "white"
    }
  },
  "modules": [
    {
      "type": "command",
      "key":  "User",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    {
      "type": "command",
      "key":  "󰌢 Host",
      "text": "hostnamectl --pretty 2>/dev/null || hostname",
      "format": "{result}"
    },
    "break",
    {
      "type": "os",
      "key":    "OS",
      "format": "{pretty-name}  [{arch}]"
    },
    {
      "type": "kernel",
      "key":    "├ Kernel",
      "format": "{sysname}  [v{release}]"
    },
    {
      "type": "packages",
      "key":    "├󰏖 Packages",
      "format": "{all}"
    },
    {
      "type": "shell",
      "key":    "└ Shell",
      "format": "{pretty-name}  [v{version}]"
    },
    "break",
    {
      "type": "wm",
      "key":    "󱂬 WM",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key":    "├ Terminal",
      "format": "{pretty-name}  [{version}]"
    },
    {
      "type": "terminalfont",
      "key":    "├ Font",
      "format": "{name}  [{size}]"
    },
    {
      "type": "wallpaper",
      "key":    "└󰸉 Wallpaper"
    },
    "break",
    {
      "type": "host",
      "key":    "󰌢 PC"
    },
    {
      "type": "cpu",
      "key":    "├󰻠 CPU",
      "showPeCoreCount": true,
      "temp": true,
      "format": "{name}  [{core-types}] [{freq-max}]"
    },
    {
      "type": "gpu",
      "key":    "├󰍛 GPU",
      "detectionMethod": "auto",
      "driverSpecific": true,
      "format": "Radeon RX 7600  [{type}]"
    },
    {
      "type": "memory",
      "key":    "├󰑭 Memory",
      "format": "{used} / {total}  ({percentage})"
    },
    {
      "type": "disk",
      "key":    "├ Disk",
      "format": "{size-used} / {size-total}  ({size-percentage})"
    },
    {
      "type": "uptime",
      "key":    "└󰅐 Uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}