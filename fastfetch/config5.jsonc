// Linux From Scratch · Fastfetch · Ficha técnica monocroma
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "lfs", "type": "builtin", "padding": { "top": 1, "left": 1 } },
  "display": {
    "separator": " : ",
    "key": { "width": 11 },
    "color": { "keys": "white", "output": "white" }
  },

  "modules": [
    { "type": "custom", "format": "― Built, not installed ―" },
    { "type": "separator", "string": "─" },

    { "type": "title", "key": "host" },
    { "type": "board", "key": "board" },
    { "type": "bootmgr", "key": "boot" },

    { "type": "separator", "string": "─" },

    { "type": "os", "key": "os", "format": "{pretty-name}  [{arch}]" },
    { "type": "kernel", "key": "kernel", "format": "{sysname}  [v{release}]" },
    { "type": "command", "key": "compiler", "text": "gcc -dumpversion 2>/dev/null", "format": "GCC {result}" },
    { "type": "shell", "key": "shell" },

    { "type": "separator", "string": "─" },

    { "type": "cpu", "key": "cpu", "temp": true, "format": "{name}  [{freq-max}]" },
    { "type": "cpucache", "key": "cache" },
    { "type": "gpu", "key": "gpu", "detectionMethod": "auto", "driverSpecific": false, "format": "{vendor} {name}" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk", "folders": "/" },

    { "type": "separator", "string": "─" },

    { "type": "uptime", "key": "uptime" }
  ]
}
