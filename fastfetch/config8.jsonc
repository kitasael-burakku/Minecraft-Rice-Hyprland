// Kitasan Black (ASCII) · Fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "color": { "keys": "33" }
  },
  "logo": { "type": "none" },
  "modules": [
    {
      "type": "custom",
      "format": "{#33}██╗  ██╗██╗████████╗ █████╗ ███████╗ █████╗ ███╗   ██╗\n{#93}██║ ██╔╝██║╚══██╔══╝██╔══██╗██╔════╝██╔══██╗████╗  ██║\n{#33}█████╔╝ ██║   ██║   ███████║███████╗███████║██╔██╗ ██║\n{#93}██╔═██╗ ██║   ██║   ██╔══██║╚════██║██╔══██║██║╚██╗██║\n{#33}██║  ██╗██║   ██║   ██║  ██║███████║██║  ██║██║ ╚████║\n{#93}╚═╝  ╚═╝╚═╝   ╚═╝   ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝╚═╝  ╚═══╝\n{#33}██████╗ ██╗      █████╗  ██████╗██╗  ██╗\n{#93}██╔══██╗██║     ██╔══██╗██╔════╝██║ ██╔╝\n{#33}██████╔╝██║     ███████║██║     █████╔╝\n{#93}██╔══██╗██║     ██╔══██║██║     ██╔═██╗\n{#33}██████╔╝███████╗██║  ██║╚██████╗██║  ██╗\n{#93}╚═════╝ ╚══════╝╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝"
    },
    "break",
    {
      "type": "command",
      "key":  "{#33}Trainer",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    {
      "type": "command",
      "key":  "{#33}󰌢 Stable",
      "text": "hostnamectl --pretty 2>/dev/null || hostname",
      "format": "{result}"
    },
    "break",
    {
      "type": "os",
      "key":    "{#33} OS",
      "format": "{pretty-name}  {#94}[{arch}]"
    },
    {
      "type": "kernel",
      "key":    "{#136}├ Kernel",
      "format": "{sysname}  {#94}[v{release}]"
    },
    {
      "type": "shell",
      "key":    "{#136}└ Shell",
      "format": "{pretty-name}  {#94}[v{version}]"
    },
    "break",
    {
      "type": "cpu",
      "key":    "{#33}󰻠 Power",
      "temp": true,
      "format": "{name}  {#94}[{freq-max}]"
    },
    {
      "type": "gpu",
      "key":    "{#244}├󰍛 Speed",
      "detectionMethod": "auto",
      "driverSpecific": false,
      "format": "{vendor} {name}"
    },
    {
      "type": "memory",
      "key":    "{#136}├󰑭 Wisdom",
      "format": "{used} / {total}  {#94}({percentage})"
    },
    {
      "type": "uptime",
      "key":    "{#136}└󰅐 Guts",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    }
  ]
}
