{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "cachyos", "type": "builtin", "padding": { "top": 3, "left": 1 } },
  "display": { "separator": " → " },

  "modules": [
    {
      "type": "command",
      "key":  "{#73} User",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    {
      "type": "command",
      "key":  "{#73}󰌢 Host",
      "text": "hostnamectl --pretty 2>/dev/null || hostname",
      "format": "{result}"
    },
    "break",
    {
      "type": "os",
      "key":    "{#73} OS",
      "format": "{pretty-name}  {#30}[{arch}]"
    },
    {
      "type": "kernel",
      "key":    "{#116}├ Kernel",
      "format": "{sysname}  {#30}[v{release}]"
    },
    {
      "type": "packages",
      "key":    "{#116}├󰏖 Packages",
      "format": "{all}"
    },
    {
      "type": "shell",
      "key":    "{#116}└ Shell",
      "format": "{pretty-name}  {#30}[v{version}]"
    },
    "break",
    {
      "type": "wm",
      "key":    "{#73}󱂬 WM",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key":    "{#116}├ Terminal",
      "format": "{pretty-name}  {#30}[{version}]"
    },
    {
      "type": "terminalfont",
      "key":    "{#116}├ Font",
      "format": "{name}  {#30}[{size}]"
    },
    {
      "type": "wallpaper",
      "key":    "{#116}└󰸉 Wallpaper"
    },
    "break",
    {
      "type": "host",
      "key":    "{#73}󰌢 PC"
    },
    {
      "type": "cpu",
      "key":    "{#116}├󰻠 CPU",
      "showPeCoreCount": true,
      "temp": true,
      "format": "{name}  {#30}[{core-types}] [{freq-max}]"
    },
    {
      "type": "gpu",
      "key":    "{#116}├󰍛 GPU",
      "detectionMethod": "auto",
      "driverSpecific": true,
      "format": "Radeon RX 7600  {#30}[{type}]"
    },
    {
      "type": "memory",
      "key":    "{#116}├󰑭 Memory",
      "format": "{used} / {total}  {#30}({percentage})"
    },
    {
      "type": "disk",
      "key":    "{#116}├ Disk",
      "format": "{size-used} / {size-total}  {#30}({size-percentage})"
    },
    {
      "type": "uptime",
      "key":    "{#116}└󰅐 Uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
