/*****----- Lanzador Kitasan Glass -----*****/
configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "󰀻 ";
    drun-display-format:        "{name}";
}

* {
    font:                       "JetBrainsMono Nerd Font Propo 10";

    bg-main:                    #1e1e1ecc;
    bg-glass:                   #1a1a1a99;
    bg-hover:                   #404040cc;
    bg-selected:                #b0bec540;

    fg:                         #e6e6e6;
    fg-muted:                   #909090;
    fg-dim:                     #6f6f6f;

    border-col:                 #b8c5cc66;
    border-soft:                #6f6f6f55;
    border-hover:               #b8c5ccaa;

    accent:                     #f7f7f7;
    accent-muted:               #b8c5cc;

    background-color:           transparent;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    width:                      500px;
    border-radius:              16px;
    border:                     1px;
    border-color:               @border-col;
    background-color:           @bg-main;
}

mainbox {
    spacing:                    0px;
    padding:                    0px;
    children:                   [ "inputbar", "listbox" ];
}

/* ── Inputbar con imagen de fondo ────────────────────────── */
inputbar {
    spacing:                    10px;
    /* padding-top grande = empuja el search al fondo de la imagen */
    padding:                    160px 16px 12px 16px;
    background-image:           url("~/.config/rofi/assets/sidebar.png", width);
    background-color:           transparent;
    border:                     0px 0px 1px 0px;
    border-color:               @border-soft;
    border-radius:              16px 16px 0px 0px;
    children:                   [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:                     false;
    str:                        "󰍉";
    padding:                    8px 12px;
    border-radius:              10px;
    background-color:           @bg-glass;
    border:                     1px;
    border-color:               @border-soft;
    text-color:                 @accent-muted;
}

entry {
    expand:                     true;
    padding:                    8px 14px;
    border-radius:              10px;
    background-color:           @bg-glass;
    border:                     1px;
    border-color:               @border-soft;
    text-color:                 @fg;
    placeholder:                "Buscar aplicaciones...";
    placeholder-color:          @fg-dim;
}

/* ── Lista ───────────────────────────────────────────────── */
listbox {
    spacing:                    10px;
    padding:                    16px;
    children:                   [ "listview" ];
}

listview {
    columns:                    1;
    lines:                      7;
    cycle:                      true;
    fixed-height:               true;
    spacing:                    4px;
}

element {
    padding:                    10px 14px;
    spacing:                    12px;
    border-radius:              10px;
    border:                     1px;
    border-color:               transparent;
    text-color:                 @fg-muted;
}

element selected.normal {
    background-color:           @bg-selected;
    text-color:                 @fg;
    border-color:               @border-hover;
}

element-icon {
    size:                       24px;
    text-color:                 inherit;
}

element-text {
    text-color:                 inherit;
    vertical-align:             0.5;
}
