/*****----- Lanzador Kitasan Glass -----*****/
@import "~/.config/rofi/config.rasi"
@import "~/.config/rofi/colors.rasi"

/* modi/show-icons/display-/window-format/terminal/matching/sorting ya
   vienen de config.rasi — este tema no necesita overrides. */

* {
    font:                       "IosevkaTerm Nerd Font Propo 11";
    background-color:           transparent;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    width:                      520px;
    border-radius:              18px;
    border:                     1px;
    border-color:               @border;
    background-color:           @bg-main;
}

mainbox {
    spacing:                    0px;
    padding:                    0px;
    children:                   [ "inputbar", "listbox" ];
}

inputbar {
    spacing:                    10px;
    padding:                    18px 18px 14px 18px;
    background-color:           transparent;
    border:                     0px 0px 1px 0px;
    border-color:               @border-soft;
    border-radius:              18px 18px 0px 0px;
    children:                   [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:                     false;
    str:                        "󰍉";
    padding:                    9px 13px;
    border-radius:              10px;
    background-color:           @bg-glass;
    border:                     1px;
    border-color:               @border-soft;
    text-color:                 @accent-muted;
}

entry {
    expand:                     true;
    padding:                    9px 15px;
    border-radius:              10px;
    background-color:           @bg-glass;
    border:                     1px;
    border-color:               @border-soft;
    text-color:                 @fg;
    placeholder:                "Search Apps...";
    placeholder-color:          @fg-dim;
    cursor:                     text;
}

/* ── Lista dinámica ───────────────────────────────── */
listbox {
    spacing:                    8px;
    padding:                    14px;
    children:                   [ "message", "listview", "mode-switcher" ];
}

listview {
    columns:                    1;
    lines:                      8;
    cycle:                      true;
    fixed-height:               false;
    dynamic:                    true;
    scrollbar:                  false;
    spacing:                    3px;
}

element {
    padding:                    9px 14px;
    spacing:                    12px;
    border-radius:              10px;
    border:                     1px;
    border-color:               transparent;
    text-color:                 @fg-muted;
    cursor:                     pointer;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg-muted;
    border-color:               transparent;
}

element selected.normal {
    background-color:           @bg-selected;
    text-color:                 @fg;
    border-color:               @border-hover;
}

element normal.active,
element alternate.active {
    background-color:           @bg-active;
    text-color:                 @fg-muted;
    border-color:               transparent;
}

element selected.active {
    background-color:           @bg-selected;
    text-color:                 @fg;
    border-color:               @border-hover;
}

element normal.urgent,
element alternate.urgent {
    background-color:           @bg-urgent;
    text-color:                 @fg;
    border-color:               @border-urgent;
}

element selected.urgent {
    background-color:           @bg-urgent;
    text-color:                 @fg;
    border-color:               @border-urgent;
}

element-icon {
    size:                       22px;
    text-color:                 inherit;
}

element-text {
    text-color:                 inherit;
    vertical-align:             0.5;
}

/* ── Cambio de modo (drun/run/filebrowser/window) ──── */
mode-switcher {
    spacing:                    8px;
    background-color:           transparent;
    text-color:                 @fg-muted;
}

button {
    padding:                    8px;
    border-radius:              10px;
    background-color:           @bg-glass;
    border:                     1px;
    border-color:               @border-soft;
    text-color:                 @fg-muted;
    cursor:                     pointer;
}

button selected {
    background-color:           @bg-selected;
    border-color:               @border-hover;
    text-color:                 @fg;
}

/* ── Mensajes / errores ───────────────────────────── */
message {
    background-color:           transparent;
    padding:                    0px 14px;
}

textbox {
    padding:                    9px 14px;
    border-radius:              10px;
    background-color:           @bg-glass;
    border:                     1px;
    border-color:               @border-soft;
    text-color:                 @fg;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

error-message {
    padding:                    14px;
    border-radius:              10px;
    background-color:           @bg-main;
    border:                     1px;
    border-color:               @border-soft;
    text-color:                 @fg;
}