/*****----- Lanzador Kitasan Glass Monocromático -----*****/
configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "󰀻 ";
    drun-display-format:        "{name}";
}

* {
    font:                       "JetBrainsMono Nerd Font Propo 11";

    bg-main:                    #121212dc;
    bg-glass:                   #1a1a1aaa;
    bg-hover:                   #2c2c2ccc;
    bg-selected:                #ffffff0c;

    fg:                         #ffffff;
    fg-muted:                   #a0a0a0;
    fg-dim:                     #5a5a5a;

    border-col:                 #ffffff25;
    border-soft:                #ffffff12;
    border-hover:               #ffffff50;

    accent:                     #ffffff;
    accent-muted:               #8a8a8a;

    background-color:           transparent;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    width:                      520px;
    border-radius:              18px;
    border:                     1px;
    border-color:               @border-col;
    background-color:           @bg-main;
}

mainbox {
    spacing:                    0px;
    padding:                    0px;
    children:                   [ "inputbar", "listbox" ];
}

/* ── Inputbar sin banner (Imagen eliminada y padding ajustado) ── */
inputbar {
    spacing:                    10px;
    padding:                    18px 18px 14px 18px;
    background-color:           transparent;
    border:                     0px 0px 1px 0px;
    border-color:               @border-soft;
    border-radius:              18px 18px 0px 0px;
    children:                   [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:                     false;
    str:                        "󰍉";
    padding:                    9px 13px;
    border-radius:              10px;
    background-color:           @bg-glass;
    border:                     1px;
    border-color:               @border-soft;
    text-color:                 @accent-muted;
}

entry {
    expand:                     true;
    padding:                    9px 15px;
    border-radius:              10px;
    background-color:           @bg-glass;
    border:                     1px;
    border-color:               @border-soft;
    text-color:                 @fg;
    placeholder:                "Buscar aplicaciones...";
    placeholder-color:          @fg-dim;
    cursor:                     text;
}

/* ── Lista dinámica ───────────────────────────────── */
listbox {
    spacing:                    8px;
    padding:                    14px;
    children:                   [ "listview" ];
}

listview {
    columns:                    1;
    lines:                      8;            /* máximo visible */
    cycle:                      true;
    fixed-height:               false;        /* se encoge si hay pocos resultados */
    dynamic:                    true;         /* se ajusta al filtrar */
    scrollbar:                  false;
    spacing:                    3px;
}

element {
    padding:                    9px 14px;
    spacing:                    12px;
    border-radius:              10px;
    border:                     1px;
    border-color:               transparent;
    text-color:                 @fg-muted;
    cursor:                     pointer;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg-muted;
    border-color:               transparent;
}

element selected.normal {
    background-color:           @bg-selected;
    text-color:                 @fg;
    border-color:               @border-hover;
}

element-icon {
    size:                       22px;
    text-color:                 inherit;
}

element-text {
    text-color:                 inherit;
    vertical-align:             0.5;
}