/*****----- Configuration -----*****/
configuration {
    modi: "drun,run,filebrowser,window";
    show-icons: true;

    display-drun: "󰀻";
    display-run: "󰁔";
    display-filebrowser: "󰉋";
    display-window: "󱂬";

    drun-display-format: "{name}";
    window-format: "{w} · {c}";
}

/*****----- Palette: Kitasan-Ship Gray Glass -----*****/
* {
    font: "JetBrainsMono Nerd Font Propo 10";

    bg-clear: transparent;

    bg-main: #1e1e1ecc;
    bg-glass: #1a1a1a99;
    bg-soft: #141414cc;
    bg-hover: #404040cc;
    bg-selected: #b0bec526;

    fg: #e6e6e6;
    fg-soft: #d8d8d8;
    fg-muted: #909090;
    fg-dim: #6f6f6f;

    border: #b8c5cc66;
    border-soft: #6f6f6f55;
    border-hover: #b8c5cc55;

    accent: #f7f7f7;
    accent-muted: #b8c5cc;
    black: #050505;

    background-color: transparent;
}

/*****----- Main Window -----*****/
window {
    transparency: "real";

    location: center;
    anchor: center;
    fullscreen: false;

    width: 760px;

    border-radius: 20px;

    background-color: @bg-main;

    border: 1px;
    border-color: @border;

    cursor: "default";
}

/*****----- Main Box -----*****/
mainbox {
    spacing: 16px;
    padding: 28px;

    background-color: transparent;

    children: [ "inputbar", "listview", "mode-switcher" ];
}

/*****----- Inputbar -----*****/
inputbar {
    spacing: 12px;
    padding: 12px 18px;

    border-radius: 16px;

    background-color: @bg-glass;

    border: 1px;
    border-color: @border-soft;

    text-color: @fg;

    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;

    text-color: @accent-muted;

    font: "JetBrainsMono Nerd Font Propo Bold 12";
}

entry {
    background-color: transparent;

    text-color: @fg;

    cursor: text;

    placeholder: "Search...";
    placeholder-color: @fg-dim;
}

/*****----- Listview -----*****/
listview {
    columns: 2;
    lines: 6;

    cycle: true;
    dynamic: true;

    scrollbar: false;

    layout: vertical;
    fixed-height: true;
    fixed-columns: true;

    spacing: 8px;
    margin: 2px 0px;

    background-color: transparent;
    text-color: @fg;
}

/*****----- Elements -----*****/
element {
    spacing: 14px;
    padding: 10px 14px;

    border-radius: 14px;

    background-color: transparent;

    text-color: @fg-muted;

    cursor: pointer;

    border: 1px;
    border-color: transparent;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg-muted;
}

element selected.normal {
    background-color: @bg-selected;

    text-color: @fg;

    border: 1px;
    border-color: @border-hover;

    border-radius: 14px;
}

element selected.active,
element selected.urgent {
    background-color: @bg-hover;

    text-color: @accent;

    border: 1px;
    border-color: @border-hover;
}

element-icon {
    size: 28px;

    background-color: transparent;

    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.0;

    background-color: transparent;

    cursor: inherit;

    text-color: inherit;
}

/*****----- Mode Switcher -----*****/
mode-switcher {
    spacing: 10px;
    margin: 6px 0px 0px 0px;

    background-color: transparent;
}

button {
    expand: true;

    padding: 10px;

    border-radius: 14px;

    background-color: @bg-glass;

    text-color: @fg-dim;

    cursor: pointer;

    border: 1px;
    border-color: @border-soft;
}

button selected {
    background-color: @bg-selected;

    text-color: @fg;

    border: 1px;
    border-color: @border-hover;
}

/*****----- Message -----*****/
message {
    background-color: transparent;
}

textbox {
    padding: 14px;

    border-radius: 14px;

    background-color: @bg-glass;

    text-color: @fg-soft;

    vertical-align: 0.5;
    horizontal-align: 0.5;

    border: 1px;
    border-color: @border-soft;
}