/* =====================================================
   WALLPAPER PICKER — Kitasan Glass (Grid Edition v3)
   ===================================================== */

configuration {
    show-icons: true;
}

* {
    font: "JetBrainsMono Nerd Font Propo 10";
    bg-main:     #1e1e1ecc;
    bg-glass:    #1a1a1a99;
    bg-hover:    #404040cc;
    bg-selected: #b0bec533; 

    fg:          #e6e6e6;
    fg-soft:     #d8d8d8;
    fg-muted:    #909090;
    fg-dim:      #6f6f6f;

    border:       #b8c5cc66;
    border-soft:  #6f6f6f55;
    border-hover: #b8c5ccaa;
    accent:       #f7f7f7;
    accent-muted: #b8c5cc;

    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 1180px;
    border-radius: 20px;
    background-color: @bg-main;
    border: 1px;
    border-color: @border;
}

mainbox {
    spacing: 20px;
    padding: 30px;
    children: [ "inputbar", "listview", "message" ];
}

inputbar {
    spacing: 12px;
    padding: 14px 18px;
    border-radius: 12px;
    background-color: @bg-glass;
    border: 1px;
    border-color: @border-soft;
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: @accent-muted;
    font: "JetBrainsMono Nerd Font Propo Bold 12";
}

entry {
    text-color: @fg;
    placeholder: "Buscar fondo de pantalla...";
    placeholder-color: @fg-dim;
}

listview {
    columns: 4;
    lines: 2;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    fixed-height: true; /* Previene deformación si un título es muy largo */
    fixed-columns: true;
    spacing: 18px;
    margin: 4px 0px;
}

element {
    orientation: vertical;
    padding: 12px;
    spacing: 8px;
    border-radius: 14px; /* Ajuste armónico con la ventana externa */
    background-color: @bg-glass;
    text-color: @fg-muted;
    border: 1px;
    border-color: @border-soft;
}

element normal.normal,
element alternate.normal {
    background-color: @bg-glass;
    text-color: @fg-muted;
    border-color: @border-soft;
}

element selected.normal {
    background-color: @bg-selected;
    text-color: @fg;
    border: 1px; /* 1px constante para eliminar el molesto "parpadeo/salto" físico */
    border-color: @border-hover;
}

element selected.active,
element selected.urgent {
    background-color: @bg-hover;
    text-color: @accent;
    border: 1px;
    border-color: @border-hover;
}

element-icon {
    size: 230px; /* Máximo aprovechamiento horizontal de tus thumbnails */
    border-radius: 10px; /* Principio de radio anidado perfecto (Padre 14px - Hijo 10px) */
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font Propo 10"; /* Fuente unificada */
}

message {
    background-color: transparent;
}

textbox {
    padding: 12px 16px;
    border-radius: 12px;
    background-color: @bg-glass;
    text-color: @fg-soft;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    border: 1px;
    border-color: @border-soft;
}