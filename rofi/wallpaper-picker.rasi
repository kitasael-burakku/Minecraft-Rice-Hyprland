/* =====================================================
   WALLPAPER PICKER — Kitasan Glass Refinado (Fila única)
   ===================================================== */

configuration {
    show-icons: true;
}

* {
    font:           "JetBrainsMono Nerd Font Propo 12";

    bg-main:        #1a1a1adc;
    bg-glass:       #141414aa;
    bg-hover:       #383838cc;
    bg-selected:    #b0bec530;

    fg:             #ececec;
    fg-soft:        #d8d8d8;
    fg-muted:       #909090;
    fg-dim:         #5a5a5a;

    border:         #b8c5cc55;
    border-soft:    #6f6f6f40;
    border-hover:   #b8c5cc99;

    accent:         #f0f0f0;
    accent-muted:   #b8c5cc;

    background-color: transparent;
    text-color: @fg;
}

window {
    transparency:   "real";
    location:       center;
    anchor:         center;
    width:          1180px;
    border-radius:  20px;
    background-color: @bg-main;
    border:         1px;
    border-color:   @border;
}

mainbox {
    spacing:        18px;
    padding:        26px;
    min-height:     220px;
    children:       [ "inputbar", "listview", "message" ];
}

/* ── Search bar ───────────────────────────────────── */
inputbar {
    spacing:        12px;
    padding:        13px 17px;
    border-radius:  12px;
    background-color: @bg-glass;
    border:         1px;
    border-color:   @border-soft;
    children:       [ "prompt", "entry" ];
}

prompt {
    text-color:     @accent-muted;
    font:           "JetBrainsMono Nerd Font Propo Bold 12";
}

entry {
    text-color:     @fg;
    placeholder:    "Find you wallpaper...";
    placeholder-color: @fg-dim;
    cursor:         text;
}

/* ── Fila única dinámica ──────────────────────────── */

listview {
    columns:        6;
    lines:          2;
    cycle:          false;
    fixed-height:   false;
    dynamic:        true;
    fixed-columns:  false;
    scrollbar:      false;
    layout:         vertical;
    spacing:        12px;
    margin:         4px 0px;
}

element {
    orientation:    vertical;
    padding:        8px;
    spacing:        8px;
    border-radius:  13px;
    background-color: @bg-glass;
    text-color:     @fg-muted;
    border:         1px;
    border-color:   @border-soft;
    cursor:         pointer;
}

element normal.normal,
element alternate.normal {
    background-color: @bg-glass;
    text-color:     @fg-muted;
    border-color:   @border-soft;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:     @fg;
    border:         1px;
    border-color:   @border-hover;
}

element selected.active,
element selected.urgent {
    background-color: @bg-hover;
    text-color:     @accent;
    border:         1px;
    border-color:   @border-hover;
}

element-icon {
    size:           155px;
    border-radius:  9px;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       inherit;
    font:             "JetBrainsMono Nerd Font Propo 9";
}

message {
    background-color: transparent;
}

textbox {
    padding:        11px 16px;
    border-radius:  12px;
    background-color: @bg-glass;
    text-color:     @fg-soft;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    border:         1px;
    border-color:   @border-soft;
}
