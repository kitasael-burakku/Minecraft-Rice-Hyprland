/* =====================================================
   WALLPAPER TYPE SELECTOR — Kitasan Glass Refinado
   ===================================================== */

configuration {
    show-icons: true;
}

* {
    font:           "JetBrainsMono Nerd Font Propo 11";

    bg-main:        #1a1a1adc;
    bg-glass:       #141414aa;
    bg-hover:       #383838cc;
    bg-selected:    #b0bec53a;

    fg:             #ececec;
    fg-soft:        #d8d8d8;
    fg-muted:       #909090;
    fg-dim:         #5a5a5a;

    border-col:     #b8c5cc55;
    border-soft:    #6f6f6f40;
    border-hover:   #b8c5cc99;

    accent:         #f0f0f0;
    accent-muted:   #b8c5cc;

    background-color: transparent;
    text-color: @fg;
}

window {
    transparency:   "real";
    location:       center;
    anchor:         center;
    fullscreen:     false;
    width:          440px;
    border-radius:  20px;
    border:         1px;
    border-color:   @border-col;
    background-color: @bg-main;
}

mainbox {
    spacing:        0px;
    padding:        0px;
    children:       [ "inputbar", "listbox" ];
}

/* ── Banner ───────────────────────────────────────── */
inputbar {
    spacing:        0px;
    padding:        80px 28px 22px 28px;
    background-image: url("~/.config/rofi/assets/sidebar.png", width);
    border:         0px 0px 1px 0px;
    border-color:   @border-soft;
    border-radius:  20px 20px 0px 0px;
    orientation:    horizontal;
    children:       [ "textbox-title" ];
}

textbox-title {
    expand:         true;
    str:            "󰋫 Select wallpaper type";
    padding:        11px 16px;
    border-radius:  11px;
    background-color: @bg-glass;
    border:         1px;
    border-color:   @border-soft;
    text-color:     @fg-muted;
    font:           "JetBrainsMono Nerd Font Propo 11";
}

listbox {
    spacing:        14px;
    padding:        18px;
    children:       [ "listview" ];
}

listview {
    columns:        1;
    lines:          2;
    cycle:          false;
    fixed-height:   true;   /* siempre son 2 opciones */
    scrollbar:      false;
    spacing:        8px;
}

element {
    spacing:        12px;
    padding:        13px 16px;
    border-radius:  12px;
    border:         1px;
    border-color:   transparent;
    text-color:     @fg-muted;
    cursor:         pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:     @fg-muted;
    border-color:   transparent;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:     @fg;
    border-color:   @border-hover;
}

element-icon {
    size:           24px;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}
