/* =====================================================
   WALLPAPER TYPE SELECTOR — Kitasan Glass
   ===================================================== */

@import "~/.config/rofi/config.rasi"
@import "~/.config/rofi/colors.rasi"

/* show-icons: true ya es el default de config.rasi — sin override acá. */

* {
    font:           "IosevkaTerm Nerd Font Propo 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    transparency:   "real";
    location:       center;
    anchor:         center;
    fullscreen:     false;
    width:          440px;
    border-radius:  20px;
    border:         1px;
    border-color:   @border;
    background-color: @bg-main;
}

mainbox {
    spacing:        0px;
    padding:        0px;
    children:       [ "inputbar", "listbox" ];
}

/* ── Banner (Imagen eliminada y padding ajustado) ── */
inputbar {
    spacing:        0px;
    padding:        22px 28px 22px 28px;
    border:         0px 0px 1px 0px;
    border-color:   @border-soft;
    border-radius:  20px 20px 0px 0px;
    orientation:    horizontal;
    children:       [ "textbox-title" ];
}

textbox-title {
    expand:         true;
    str:            "󰋫 Select wallpaper type";
    padding:        11px 16px;
    border-radius:  11px;
    background-color: @bg-glass;
    border:         1px;
    border-color:   @border-soft;
    text-color:     @fg-muted;
    font:           "IosevkaTerm Nerd Font Propo 11";
}

listbox {
    spacing:        14px;
    padding:        18px;
    children:       [ "listview" ];
}

listview {
    columns:        1;
    lines:          3;
    cycle:          false;
    fixed-height:   false;
    scrollbar:      false;
    spacing:        8px;
}

element {
    spacing:        12px;
    padding:        13px 16px;
    border-radius:  12px;
    border:         1px;
    border-color:   transparent;
    text-color:     @fg-muted;
    cursor:         pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:     @fg-muted;
    border-color:   transparent;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:     @fg;
    border-color:   @border-hover;
}

element-icon {
    size:           24px;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}