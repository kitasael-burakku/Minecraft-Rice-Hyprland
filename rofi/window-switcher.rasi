/* =====================================================
   WINDOW SWITCHER — Kitasan Glass
   ===================================================== */

configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";
}

@import "~/.config/rofi/colors.rasi"

* {
    font:           "JetBrainsMono Nerd Font Propo 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            580px;
    border-radius:    20px;
    border:           1px;
    border-color:     @border;
    background-color: @bg-main;
}

mainbox {
    spacing:          0px;
    padding:          0px;
    children:         [ "inputbar", "listbox" ];
}

/* ── Header ───────────────────────────────────────── */
inputbar {
    spacing:          10px;
    padding:          14px 18px;
    background-color: #0c0c0cbb;
    border:           0px 0px 1px 0px;
    border-color:     @border-soft;
    children:         [ "prompt", "entry" ];
}

prompt {
    expand:           false;
    padding:          8px 12px;
    border-radius:    10px;
    background-color: @bg-glass;
    border:           1px;
    border-color:     @border-soft;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Propo Bold 13";
}

entry {
    expand:           true;
    padding:          8px 14px;
    border-radius:    10px;
    background-color: @bg-glass;
    border:           1px;
    border-color:     @border-soft;
    text-color:       @fg;
    cursor:           text;
    placeholder:      "Find your window...";
    placeholder-color: @fg-dim;
}

/* ── Lista ────────────────────────────────────────── */
listbox {
    spacing:          10px;
    padding:          14px 16px 16px 16px;
    children:         [ "listview", "message" ];
}

listview {
    columns:          1;
    lines:            8;
    cycle:            true;
    fixed-height:     false;
    dynamic:          true;
    scrollbar:        false;
    spacing:          4px;
    background-color: transparent;
}

element {
    padding:          10px 14px;
    spacing:          12px;
    border-radius:    11px;
    border:           1px;
    border-color:     transparent;
    background-color: transparent;
    text-color:       @fg-muted;
    cursor:           pointer;
    orientation:      horizontal;
}

/* Ventana activa — normal */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg-soft;
    border-color:     transparent;
}

/* Ventana seleccionada */
element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg;
    border-color:     @border-hover;
}

/* Ventana urgente / minimizada (adaptada a la paleta monocromática) */
element normal.urgent,
element alternate.urgent {
    background-color: @bg-minimized;
    text-color:       @fg-muted;
    border-color:     #ffffff20;
}

element selected.urgent {
    background-color: @bg-minimized;
    text-color:       @fg;
    border-color:     @border-hover;
}

element-icon {
    size:             22px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}

/* ── Message (empty state) ────────────────────────── */
message {
    background-color: transparent;
}

textbox {
    padding:          10px 14px;
    border-radius:    10px;
    background-color: @bg-glass;
    text-color:       @fg-muted;
    vertical-align:   0.5;
    horizontal-align: 0.5;
    border:           1px;
    border-color:     @border-soft;
}