/* =====================================================
   KITASAN GLASS — paleta compartida de rofi (dinámica)
   Generado por matugen — no editar a mano.
   Estático de referencia: ~/.config/rofi/colors.static.rasi
   ===================================================== */

* {
    bg-main:        #19120dcc;
    bg-glass:       #261e19aa;
    bg-hover:       #312823cc;
    bg-selected:    #ffb68810;
    bg-active:      #ffb6881f;
    bg-urgent:      #ffb4ab2a;
    bg-minimized:   #ffb68810;

    danger-bg:      #ffb4ab22;
    danger-fg:      #ffdad6;

    fg:             #f0dfd7;
    fg-soft:        #d7c3b8;
    fg-muted:       #e5bfa8;
    fg-dim:         #9f8d83;

    border:         #ffb68828;
    border-soft:    #ffb68814;
    border-hover:   #ffb68855;
    border-urgent:  #ffb4ab60;

    accent:         #ffb688;
    accent-muted:   #caca93;
}
