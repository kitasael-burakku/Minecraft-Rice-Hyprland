/* =====================================================
   KITASAN GLASS — paleta compartida de rofi (dinámica)
   Generado por matugen — no editar a mano.
   Estático de referencia: ~/.config/rofi/colors.static.rasi
   ===================================================== */

* {
    bg-main:        #12140dcc;
    bg-glass:       #1e2019aa;
    bg-hover:       #292b23cc;
    bg-selected:    #b7d08510;
    bg-active:      #b7d0851f;
    bg-urgent:      #ffb4ab2a;
    bg-minimized:   #b7d08510;

    danger-bg:      #ffb4ab22;
    danger-fg:      #ffdad6;

    fg:             #e3e3d8;
    fg-soft:        #c6c8b9;
    fg-muted:       #c2caab;
    fg-dim:         #8f9284;

    border:         #b7d08528;
    border-soft:    #b7d08514;
    border-hover:   #b7d08555;
    border-urgent:  #ffb4ab60;

    accent:         #b7d085;
    accent-muted:   #a0d0c8;
}
