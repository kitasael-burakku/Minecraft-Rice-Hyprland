/* =====================================================
   POWER MENU — Kitasan Glass Refinado
   ===================================================== */

configuration {
    show-icons: false;
}

* {
    font:           "DepartureMono Nerd Font 12";

    bg:             #1a1a1adc;
    bg-glass:       #141414aa;
    bg-hover:       #383838cc;

    fg:             #ececec;
    fg-muted:       #909090;
    fg-dim:         #5a5a5a;

    border:         #b0bec555;
    border-soft:    #b0bec530;
    border-hover:   #b0bec599;

    accent:         #f0f0f0;
    accent-muted:   #b8c5cc;

    danger:         #ff4f5e;
    danger-bg:      #ff4f5e1a;

    background-color: transparent;
    text-color: @fg;
}

window {
    width:            420px;
    location:         center;
    anchor:           center;
    border-radius:    22px;
    background-color: @bg;
    border:           1px;
    border-color:     @border;
    padding:          0px;
}

mainbox {
    spacing:          16px;
    padding:          22px;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

/* ── Header ───────────────────────────────────────── */
inputbar {
    padding:          12px 16px;
    spacing:          10px;
    border-radius:    14px;
    background-color: @bg-glass;
    border:           1px;
    border-color:     @border-soft;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color:       @accent-muted;
    font:             "DepartureMono Nerd Font 13";
}

entry {
    placeholder:      "Confirma con Enter...";
    placeholder-color: @fg-dim;
    text-color:       @fg;
    background-color: transparent;
}

/* ── Lista — se ajusta a las 5 opciones exactas ───── */
listview {
    lines:            5;
    columns:          1;
    spacing:          8px;
    cycle:            true;
    fixed-height:     true;   /* el power menu siempre muestra las 5 opciones */
    scrollbar:        false;
    background-color: transparent;
}

element {
    padding:          13px 16px;
    spacing:          12px;
    border-radius:    14px;
    background-color: transparent;
    text-color:       @fg-muted;
    border:           1px;
    border-color:     transparent;
    cursor:           pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg-muted;
    border-color:     transparent;
}

element selected.normal {
    background-color: @bg-hover;
    text-color:       @accent;
    border:           1px;
    border-color:     @border-hover;
}

/* Opción de apagado resaltada en rojo al seleccionar */
element selected.urgent {
    background-color: @danger-bg;
    text-color:       @danger;
    border:           1px;
    border-color:     @danger;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

message {
    background-color: transparent;
}

textbox {
    padding:          11px 14px;
    border-radius:    12px;
    background-color: @bg-glass;
    text-color:       @fg;
    border:           1px;
    border-color:     @border-soft;
}
