/* =====================================================
   POWER MENU — Kitasan Glass
   ===================================================== */

@import "~/.config/rofi/config.rasi"
@import "~/.config/rofi/colors.rasi"

configuration {
    show-icons: false;
}

* {
    font:           "IosevkaTerm Nerd Font Propo 13";
    bg:             @bg-main;
    background-color: transparent;
    text-color: @fg;
}

window {
    width:            420px;
    location:         center;
    anchor:           center;
    border-radius:    22px;
    background-color: @bg;
    border:           1px;
    border-color:     @border;
    padding:          0px;
}

mainbox {
    spacing:          16px;
    padding:          22px;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

/* ── Header (Estilo de wallpaper-type-select) ─────── */
inputbar {
    padding:          0px;
    spacing:          0px;
    background-color: transparent;
    orientation:      horizontal;
    children:         [ "textbox-title" ];
}

textbox-title {
    expand:           true;
    str:              "Enter to select";
    padding:          12px 16px;
    border-radius:    14px;
    background-color: @bg-glass;
    border:           1px;
    border-color:     @border-soft;
    text-color:       @fg-muted;
    font:             "IosevkaTerm Nerd Font Propo 13";
}

/* ── Lista — se ajusta a las 5 opciones exactas ───── */
listview {
    lines:            5;
    columns:          1;
    spacing:          8px;
    cycle:            true;
    fixed-height:   false;
    dynamic:        true;
    fixed-columns:  false;
    scrollbar:        false;
    background-color: transparent;
}

element {
    padding:          13px 16px;
    spacing:          12px;
    border-radius:    14px;
    background-color: transparent;
    text-color:       @fg-muted;
    border:           1px;
    border-color:     transparent;
    cursor:           pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg-muted;
    border-color:     transparent;
}

element selected.normal {
    background-color: @bg-hover;
    text-color:       @accent;
    border:           1px;
    border-color:     @border-hover;
}

element selected.urgent {
    background-color: @danger-bg;
    text-color:       @danger-fg;
    border:           1px;
    border-color:     @accent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

message {
    background-color: transparent;
}

textbox {
    padding:          11px 14px;
    border-radius:    12px;
    background-color: @bg-glass;
    text-color:       @fg;
    border:           1px;
    border-color:     @border-soft;
}