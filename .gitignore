# ── Caches / estado ──────────────────────────────────────────
.cache/
**/Cache/
**/Code Cache/
**/GPUCache/
**/*.log
**/*.tmp
**/*.bak
**/*.old
**/*.swp
**/__pycache__/
**/*.pyc

# ── Generados / estado local ─────────────────────────────────
fastfetch/.fastfetch_bag
fish/fish_variables
matugen/enabled
# Igual que matugen/enabled: estado de sesión, no diseño del rice. Lo escriben
# rofi/scripts/theme.sh (SUPER+ALT+W) y `kitasan theme`, y matugen_reload.sh
# cae a scheme-tonal-spot si no existe — así que un clon nuevo no necesita el
# archivo. Versionado solo generaba un commit por cada cambio de esquema.
matugen/scheme
hypr/.current-wallpaper
hyprlock/wallpapers/current.png

# ── Privado (ver hypr/modules/private.example.lua) ───────────
hypr/modules/private.lua

# ── Colores generados por matugen (fuente: matugen/templates/ +
#    *.static.* — correr hypr/scripts/apply-static-colors.sh tras
#    clonar para poblarlos con la paleta estática) ──────────────
rofi/colors.rasi
waybar/colors.css
kitty/colors/colors.conf
wlogout/colors.css
hyprlock/colors.conf
swaync/colors.css
/starship.toml
fish/conf.d/theme-goldship.fish
hypr/dynamic-colors.sh
hyprlock/scripts/music-colors.sh

# Estos 4 no llegan al repo hoy por otra vía (gtk-3.0/, qt5ct/, qt6ct/ no son
# config_dirs de dotbackup — solo copia archivos puntuales, ver
# ~/.local/bin/dotbackup), pero si eso cambiara algún día, nada los frenaría
# sin esta regla. Defensa en profundidad, no una fuga activa.
gtk-3.0/gtk-colors.css
gtk-4.0/gtk-colors.css
qt5ct/colors/kitasan-glass.conf
qt6ct/colors/kitasan-glass.conf

# ── Funciones locales (no parte del rice) ────────────────────
fish/functions/RPS.exe.fish

# ── Media pesada ─────────────────────────────────────────────
*.mov
*.mkv
*.webm
*.mp4

# ── Secretos ─────────────────────────────────────────────────
*.key
*.pem
*.token
*token*
*secret*
*password*
*credentials*

# ── Editor / sistema ─────────────────────────────────────────
# Excepción: hypr/.vscode/settings.json apunta el LSP de Lua a los stubs
# oficiales de Hyprland — es lo que hace usable escribir contra la API
# hl.*, se publica a propósito. El resto de .vscode/ (en cualquier otra
# carpeta) sigue ignorado.
.vscode/
!hypr/.vscode/
!hypr/.vscode/settings.json
.idea/
.DS_Store

# ── IA ───────────────────────────────────────────────────────
CLAUDE.md
.claude

# ── Personal Alias ───────────────────────────────────────────
fish/conf.d/local.fish

# ── Completions locales (no parte del rice) ──────────────────
# El ignore global existe por maly.fish (proyecto privado). Excepción para
# ec.fish: fish/functions/ec.fish SÍ se publica, así que sin su completion el
# repo publicaba la función a medias — `ec <TAB>` no funcionaba tras clonar.
# Solo declara los nombres de directorios de config, nada privado.
# Se ignora el CONTENIDO (fish/completions/*) y no el directorio: git no
# desciende a un directorio excluido, así que con "fish/completions/" la
# excepción de abajo nunca se llegaba a evaluar.
# Misma razón para kitasan.fish: fish/functions/kitasan.fish es público, sin
# su completion `kitasan <TAB>` tampoco andaría tras clonar.
fish/completions/*
!fish/completions/ec.fish
!fish/completions/kitasan.fish