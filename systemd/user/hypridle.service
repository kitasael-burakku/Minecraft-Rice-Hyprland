[Unit]
Description=Hypridle — bloqueo de pantalla e idle management
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=%h/.config/hypr/scripts/wait-for-hyprland.sh
ExecStart=/usr/bin/hypridle
# Restart=always (no on-failure): de los daemons de esta sesión, éste es el
# único con impacto de seguridad directo — si muere, la pantalla deja de
# bloquearse sola. Antes no había supervisión de ningún tipo.
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
