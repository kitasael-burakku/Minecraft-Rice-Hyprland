{
    "layer": "top",
    "position": "top",
    "spacing": 2,       // Separación horizontal entre módulos
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "pulseaudio",
        "pulseaudio/slider",
        "custom/playerctl",
        "custom/playerlabel"
    ],
    "modules-center": [
        "hyprland/window",
        "hyprland/workspaces",
        "clock"
    ],
    "modules-right": [
        "custom/updates",
        "privacy",
        "temperature",
        "cpu",
        "memory",
        "disk",
        "custom/gpu",
        "power-profiles-daemon",
        "bluetooth",
        "network",
        "idle_inhibitor",
        "tray",
        "custom/power"
    ],

    "hyprland/window": {
        "format": "󰣇 {title}",
        "max-length": 25,
        "separate-outputs": true,
        "rewrite": {
            "^.*Mozilla Firefox.*$": "󰈹 Firefox",
            "^.*Zen Browser.*$":     "󰈹 Zen",
            "^.*Spotify.*$":         "󰓇 Spotify",
            "^.*fish.*$":            " Terminal",
            "^.*Thunar.*$":          "󰉋 Files",
            "^.*Discord.*$":         "󰙯 Discord",
            "^.*VSCodium.*$":        "󰨞 VSCodium",
            "^.*Steam.*$":           "󰓓 Steam",
            "^.*OBS.*$":             "󰐻 OBS Studio",
            "^.*btop.*$":            "󰍛 Btop",
            "^.*Goverlay.*$":        "󰊖 GOverlay",
            "^.*keybinds.*$":        "󰌌 Keybinds",
            "^.*sysupdate.*$":       "󰚰 Sysupdate"
        }
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "clock": {
        "interval": 60,
        "format": "󰥔 {:%H:%M}",
        "max-length": 25,
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": "•"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂯 {volume}%",
        "format-muted": "󰖁 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 2,
        // Antes abría pavucontrol (GUI pesada) para el caso común de
        // "cambiar a los auriculares" — rofi/scripts/audio.sh lista
        // sinks/sources y fija el default con wpctl, sin abrir nada
        // pesado. pavucontrol sigue instalado y a un SUPER+SPACE de
        // distancia para mezcla per-app, que audio.sh no cubre.
        "on-click": "~/.config/rofi/scripts/audio.sh",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "cpu": {
        "interval": 5,
        "format": "󰍛 {usage}%"
    },

    "memory": {
        "interval": 10,
        "format": " {percentage}%",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": "     Memory\n\nUsed:  {used:0.1f} GB ({percentage}%)\nAvailable:  {avail:0.1f} GB\nTotal:  {total:0.1f} GB"
    },

    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "tooltip": true,
        "unit": "GB",
        "tooltip-format": "     Storage ({path})\n\nUsed:  {specific_used:0.1f} GB ({percentage_used}%)\nFree:  {specific_free:0.1f} GB ({percentage_free}%)\nTotal: {specific_total:0.1f} GB"
    },

    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰈂 Disconnected",
        "tooltip-format-wifi": "󰖩 {essid}\n󰩟 {ipaddr}\n󰈀 {ifname}\n󰖩 {signalStrength}%",
        "tooltip-format-ethernet": " Ethernet\n󰩟 {ipaddr}\n󰈀 {ifname}",
        "tooltip-format-disconnected": "Disconnected",
        // Antes abría nm-connection-editor (GTK, lento). rofi/scripts/wifi.sh
        // lista redes con nmcli y conecta en el mismo click.
        "on-click": "~/.config/rofi/scripts/wifi.sh"
    },

    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "interval": 30,
        "signal": 8,
        "return-type": "json",
        "on-click": "kitty fish -lc 'sysupdate; ~/.config/waybar/scripts/updates.sh --force >/dev/null; read -P \"Press Enter to exit\"'; pkill -RTMIN+8 waybar",
        "format": "{}",
        "tooltip": true
    },

    "temperature": {
        "interval": 4,
        // Path fijo al hwmon del CPU (función PCI 00:18.3, propia del die AMD).
        // hwmon-path-abs: "/sys/class/hwmon" tomaba la primera entrada por orden
        // de directorio (no determinista: podía caer en nct6687, nvme, etc. en
        // vez de k10temp) y thermal-zone no aplica en este equipo (no hay
        // /sys/class/thermal/thermal_zone*, solo cooling_device*).
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "format": "{icon} {temperatureC}°C",
        "tooltip-format": " CPU Temperature\n\nSensor: k10temp\nCurrent: {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
        "critical-threshold": 75
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈",
            "deactivated": "󰈉"
        },
        "tooltip-format-activated": "Idle inhibitor: active",
        "tooltip-format-deactivated": "Idle inhibitor: inactive"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/wlogout/scripts/launch_wlogout.sh"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "interval": 5,
        "return-type": "json",
        "format": "{}",
        "tooltip": true
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Perfil de energía: {profile}\nClick para cambiar",
        "format-icons": {
            "default": "󰊚",
            "performance": "󰓅",
            "balanced": "󰗑",
            "power-saver": "󰌪"
        }
    },

    "bluetooth": {
        "format": "󰂯 Enable",
        "format-disabled": "󰂲 Disabled",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        // Antes abría blueman-manager. rofi/scripts/bluetooth.sh cubre el
        // 95% del uso real (conectar/desconectar algo ya emparejado) sin
        // abrir una ventana — blueman-manager sigue disponible para
        // emparejar dispositivos nuevos.
        "on-click": "~/.config/rofi/scripts/bluetooth.sh"
    },

    "privacy": {
        "icon-spacing": 4,
        "icon-size": 14,
        "transition-duration": 250,
        "modules": [
            { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 24 },
            { "type": "audio-in", "tooltip": true, "tooltip-icon-size": 24 }
        ]
    },

    "custom/playerctl": {
        "format": "{icon}",
        "return-type": "json",
        "max-length": 36,
        "exec": "~/.config/waybar/scripts/playerctl-read.sh",
        "on-click": "playerctl play-pause",
        // Click derecho: con más de un reproductor abierto (Spotify + navegador
        // + maly) `playerctl` sin -p actúa sobre el que él elija — este selector
        // deja controlar uno específico a propósito.
        "on-click-right": "~/.config/rofi/scripts/mpris.sh",
        "tooltip": false,
        "format-icons": {
            "Playing": "󰏥 ",
            "Paused": "󰐌 ",
            "Stopped": "󰐍 "
        }
    },

    "custom/playerlabel": {
        "format": "{}",
        "return-type": "json",
        "max-length": 36,
        "exec": "~/.config/waybar/scripts/playerctl-read.sh",
        "on-click": "playerctl previous",
        "on-click-middle": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "tooltip": false
    }
}