{
    "layer": "top",
    "position": "top",
    "spacing": 2,       // Separación horizontal entre módulos
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,

    // Necesario para el experimento de zonas: Waybar vigila style.css y todos
    // sus @import, así que reescribir zone.css basta para cambiar la barra sin
    // reiniciarla ni reconstruirla. Viene en false por defecto.
    "reload_style_on_change": true,

    // EXPERIMENTO (zonas por posición del cursor): los tres bloques de abajo se
    // corresponden 1:1 con las cajas .modules-left / .modules-center /
    // .modules-right. Los dos laterales se ocultan en reposo y aparecen cuando
    // el cursor entra en su tercio de la franja superior; el centro es
    // permanente. Quien decide es scripts/cursor-zone.py reescribiendo
    // zone.css. Ver la sección "ZONAS" al final de style.css.
    //
    // Mover un módulo entre laterales no pide tocar nada más: las reglas usan
    // "> *", así que cubren lo que haya en la caja.

    // Bloque de música y volumen: oculto en reposo, aparece en la zona izquierda.
    // custom/zone no se ve nunca; solo vive aquí para que Waybar sea dueño del
    // ciclo de vida del vigilante. Puede estar en cualquiera de las tres listas,
    // pero tiene que estar en alguna o se acaban las zonas.
    // Va el ÚLTIMO por la cascada de aparición: los retrasos se reparten por
    // posición (:nth-child) y, estando el primero, se llevaba el turno de 0ms
    // siendo invisible y retrasaba 32ms a todo lo que sí se ve.
    "modules-left": [
        "custom/playerctl",
        "custom/playerlabel",
        "pulseaudio/slider",
        "custom/zone"
    ],
    // Centro permanente: nada de aquí se oculta nunca.
    //
    // El criterio de reparto es "control vs estado": lo que se USA puede
    // esconderse en un lateral, lo que hay que ENTERARSE de que pasa no puede
    // depender de que muevas el ratón a una esquina. Por eso aquí no hay ni
    // una métrica de sistema (esas se consultan, y viven todas juntas a la
    // derecha) y sí están los avisos.
    //
    //   window/workspaces/clock  contexto, navegación y hora
    //   pulseaudio               estado + rueda para el volumen
    //   updates/privacy/notif.   avisos; en reposo ocupan cero o casi
    //   tray                     un solo icono estático (udiskie), y su
    //                            "needs-attention" era invisible escondido
    //   idle_inhibitor           un toggle cuyo estado no se podía consultar;
    //                            apagado va al 25% para no hacer ruido
    "modules-center": [
        "hyprland/window",
        "hyprland/workspaces",
        "clock",
        "pulseaudio",
        "privacy",
        "custom/notification",
        "idle_inhibitor",
        "tray",
        "custom/updates"
    ],
    // Bloque de sistema: oculto en reposo, aparece en la zona derecha.
    // Waybar dibuja esta lista de izquierda a derecha, así que el ÚLTIMO es el
    // que queda pegado al borde de la pantalla: custom/power.
    //
    // Orden: primero las cinco MÉTRICAS juntas (cpu, memory, temperature, gpu,
    // disk), pegadas al centro porque son las que se miran de un vistazo al
    // asomarse; después los CONTROLES (perfil de energía, bluetooth, red); y
    // el apagado al borde, lo más lejos posible del resto.
    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "custom/gpu",
        "disk",
        "power-profiles-daemon",
        "custom/bluetooth",
        "network",
        "custom/power"
    ],

    // OJO con el markup en los tooltips: los módulos NATIVOS (memory, disk,
    // temperature...) los ponen con set_tooltip_text, así que <tt>/<b> salen
    // impresos literalmente. Solo los custom/* (usan set_tooltip_markup) y el
    // reloj admiten markup — por eso "<tt>{calendar}</tt>" de abajo sí va.
    "hyprland/window": {
        "format": "󰣇 {title}",
        "max-length": 50,
        "separate-outputs": true,
        "rewrite": {
            "^.*Mozilla Firefox.*$": "󰈹 Firefox",
            "^.*Zen Browser.*$":     "󰈹 Zen Browser",
            "^.*Spotify.*$":         "󰓇 Spotify",
            "^.*fish.*$":            " Terminal",
            "^.*Thunar.*$":          "󰉋 Files",
            "^.*Discord.*$":         "󰙯 Discord",
            "^.*VSCodium.*$":        "󰨞 VSCodium",
            "^.*Steam.*$":           "󰓓 Steam",
            "^.*OBS.*$":             "󰐻 OBS Studio",
            "^.*btop.*$":            "󰍛 Btop",
            "^.*Goverlay.*$":        "󰊖 GOverlay",
            "^.*keybinds.*$":        "󰌌 Keybinds",
            "^.*sysupdate.*$":       "󰚰 Sysupdate"
        }
    },

    // Módulo sin salida: existe solo para que Waybar sea dueño del ciclo de vida
    // del vigilante de zona (arranca y muere con la barra, sin tocar Hyprland ni
    // systemd). El script no imprime nada, así que el módulo queda vacío.
    "custom/zone": {
        "exec": "~/.config/waybar/scripts/cursor-zone.py",
        "format": "",
        "tooltip": false
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "clock": {
        "interval": 60,
        "format": "󰥔 {:%H:%M}",
        "max-length": 25,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "today": "<b><u>{}</u></b>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        },
        "on-click": "hyprctl clients | grep -i 'title: calcurse' >/dev/null && pkill -f 'kitty --title calcurse' || kitty --title calcurse -e calcurse"
    },
    
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": "•"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂯 {volume}%",
        "format-muted": "󰖁 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 2,
        "on-click": "~/.config/rofi/scripts/audio.sh",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-middle":"hyprctl clients | grep -i 'title: maly' >/dev/null && pkill -f 'kitty --title maly' || kitty --title maly -e maly"
    },

    "cpu": {
        "interval": 5,
        "format": "󰍛 {usage}%",
        "on-click":"hyprctl clients | grep -i 'title: btop' >/dev/null && pkill -f 'kitty --title btop' || kitty --title btop -e btop"
    },

    "memory": {
        "interval": 10,
        "format": " {percentage}%",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": "     Memory\n\nUsed:  {used:0.1f} GB ({percentage}%)\nAvailable:  {avail:0.1f} GB\nTotal:  {total:0.1f} GB"
    },

    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "tooltip": true,
        "unit": "GB",
        "tooltip-format": "     Storage ({path})\n\nUsed:  {specific_used:0.1f} GB ({percentage_used}%)\nFree:  {specific_free:0.1f} GB ({percentage_free}%)\nTotal: {specific_total:0.1f} GB",
        "on-click": "hyprctl clients | grep -i 'title: duf' >/dev/null && pkill -f 'kitty --title duf' || kitty --title duf -e fish -lc 'duf; read -P \"Press Enter to exit\"'"
    },

    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰈂 Disconnected",
        "tooltip-format-wifi": "󰖩 {essid}\n󰩟 {ipaddr}\n󰈀 {ifname}\n󰖩 {signalStrength}%",
        "tooltip-format-ethernet": " Ethernet\n󰩟 {ipaddr}\n󰈀 {ifname}",
        "tooltip-format-disconnected": "Disconnected\n\nLeft click to pick a network",
        "on-click": "~/.config/rofi/scripts/wifi.sh"
    },

    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "interval": "once",
        "signal": 8,
        "return-type": "json",
        "on-click": "kitty fish -lc 'sysupdate; ~/.config/waybar/scripts/updates.sh --force >/dev/null; read -P \"Press Enter to exit\"'; pkill -RTMIN+8 waybar",
        "on-click-right": "hyprctl clients | grep -i 'title: updates-list' >/dev/null && pkill -f 'kitty --title updates-list' || kitty --title updates-list -e ~/.config/waybar/scripts/updates.sh --list",
        "on-click-middle": "systemctl --user start updates-check.service",
        "format": "{}",
        "tooltip": true
    },

    "temperature": {
        "interval": 4,
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "format": "{icon} {temperatureC}°C",
        "tooltip-format": " CPU Temperature\n\nSensor: k10temp\nCurrent: {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
        "critical-threshold": 75
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈",
            "deactivated": "󰈉"
        },
        "tooltip-format-activated": "Idle inhibitor: active",
        "tooltip-format-deactivated": "Idle inhibitor: inactive"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/wlogout/scripts/launch_wlogout.sh"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/notification": {
        "exec": "~/.config/waybar/scripts/notifications.sh",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "on-click": "swaync-client -t -sw",
        "on-click-middle": "swaync-client -C -sw",
        "on-click-right": "swaync-client -d -sw"
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "interval": 5,
        "return-type": "json",
        "format": "{}",
        "tooltip": true
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Energy Profile: {profile}\n    Click to change",
        "format-icons": {
            "default": "󰊚",
            "performance": "󰓅",
            "balanced": "󰗑",
            "power-saver": "󰌪"
        }
    },

    "custom/bluetooth": {
        "exec": "~/.config/waybar/scripts/bluetooth.sh",
        "interval": 20,
        "signal": 9,
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "on-click": "~/.config/rofi/scripts/bluetooth.sh",
        "on-click-right": "~/.config/waybar/scripts/bluetooth.sh --toggle",
        "on-click-middle": "blueman-manager"
    },

    "privacy": {
        "icon-spacing": 4,
        "icon-size": 14,
        "transition-duration": 250,
        "modules": [
            { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 24 },
            { "type": "audio-in", "tooltip": true, "tooltip-icon-size": 24 }
        ]
    },

    "custom/playerctl": {
        "format": "{icon}",
        "return-type": "json",
        "max-length": 36,
        "exec": "~/.config/waybar/scripts/playerctl-read.sh",
        "on-click": "playerctl play-pause",
        "on-click-right": "~/.config/rofi/scripts/mpris.sh",
        "tooltip": false,
        "format-icons": {
            "Playing": "󰏥 ",
            "Paused": "󰐌 ",
            "Stopped": "󰐍 "
        }
    },

    "custom/playerlabel": {
        "format": "{}",
        "return-type": "json",
        "max-length": 50,
        "exec": "~/.config/waybar/scripts/playerctl-read.sh",
        "on-click": "playerctl previous",
        "on-click-middle": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "tooltip": true
    }
}