{
    "spacing": 2,       // Separación horizontal entre módulos
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    
    "modules-left": [
        "pulseaudio",
        "pulseaudio/slider",
        "custom/playerctl",
        "custom/playerlabel",
        "clock"
    ],
    "modules-center": [
        "hyprland/window",
        "hyprland/workspaces",
        "wlr/taskbar",
        "idle_inhibitor"
    ],
    "modules-right": [
        "custom/updates",
        "network",
        "temperature",
        "cpu",
        "memory",
        "disk",
        "custom/power"
    ],

    "hyprland/window": {
        "format": "󰣇 {title}",
        "max-length": 25,
        "separate-outputs": true,
        "rewrite": {
            "^.*Mozilla Firefox.*$": "󰈹 Firefox",
            "^.*Zen Browser.*$":     "󰈹 Zen",
            "^.*Spotify.*$":         "󰓇 Spotify",
            "^.*fish.*$":            " Terminal",
            "^.*Thunar.*$":          "󰉋 Files",
            "^.*Discord.*$":         "󰙯 Discord",
            "^.*VSCodium.*$":        "󰨞 VSCodium",
            "^.*Steam.*$":           "󰓓 Steam",
            "^.*OBS.*$":             "󰐻 OBS Studio",
            "^.*btop.*$":            "󰍛 Btop",
            "^.*Goverlay.*$":        "󰊖 GOverlay",
            "^.*keybinds.*$":        "󰌌 Keybinds",
            "^.*sysupdate.*$":       "󰚰 Sysupdate"
        }
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "clock": {
        "interval": 60,
        "format": "󰥔 {:%H:%M}",
        "max-length": 25,
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": "•"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize",
        "sort-by-app-id": true,
        "ignore-list": ["kitty"],
        "app_ids-mapping": {
            "zen-alpha": "firefox",
            "zen-beta":  "firefox"
        }
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂯 {volume}%",
        "format-muted": "󰖁 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 2,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "cpu": {
        "interval": 5,
        "format": "󰍛 {usage}%"
    },

    "memory": {
        "interval": 10,
        "format": " {percentage}%",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": "     Memory\n\nUsed:  {used:0.1f} GB ({percentage}%)\nAvailable:  {avail:0.1f} GB\nTotal:  {total:0.1f} GB"
    },

    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "tooltip": true,
        "unit": "GB",
        "tooltip-format": "     Storage ({path})\n\nUsed:  {specific_used:0.1f} GB ({percentage_used}%)\nFree:  {specific_free:0.1f} GB ({percentage_free}%)\nTotal: {specific_total:0.1f} GB"
    },

    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰈂 Disconnected",
        "tooltip-format-wifi": "󰖩 {essid}\n󰩟 {ipaddr}\n󰈀 {ifname}\n󰖩 {signalStrength}%",
        "tooltip-format-ethernet": " Ethernet\n󰩟 {ipaddr}\n󰈀 {ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
    },

    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "interval": 30,
        "signal": 8,
        "return-type": "json",
        "on-click": "kitty fish -lc 'sysupdate; ~/.config/waybar/scripts/updates.sh --force >/dev/null; read -P \"Press Enter to exit\"'; pkill -RTMIN+8 waybar",
        "format": "{}",
        "tooltip": true
    },

    "temperature": {
        "interval": 4,
        "thermal-zone": 0, // Intenta leer primero la zona térmica general
        "hwmon-path-abs": "/sys/class/hwmon", 
        "input-filename": "temp1_input",
        "format": "{icon} {temperatureC}°C",
        "tooltip-format": " CPU Temperature\n\nSensor: k10temp\nCurrent: {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
        "critical-threshold": 75
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈",
            "deactivated": "󰈉"
        },
        "tooltip-format-activated": "Idle inhibitor: active",
        "tooltip-format-deactivated": "Idle inhibitor: inactive"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        // Antes llamaba a un power-menu.sh propio de Waybar, con su propia
        // política de confirmación (distinta de wlogout — ej. no ofrecía
        // hibernar, y suspendía sin bloquear la pantalla antes). Un solo
        // menú de sesión, no dos con reglas distintas.
        "on-click": "~/.config/wlogout/scripts/launch_wlogout.sh"
    },

    "custom/playerctl": {
        "format": "{icon}",
        "return-type": "json",
        "max-length": 36,
        "exec": "~/.config/waybar/scripts/playerctl-read.sh",
        "on-click": "playerctl play-pause",
        "tooltip": false,
        "format-icons": {
            "Playing": "󰏥 ",
            "Paused": "󰐌 ",
            "Stopped": "󰐍 "
        }
    },

    "custom/playerlabel": {
        "format": "{}",
        "return-type": "json",
        "max-length": 36,
        "exec": "~/.config/waybar/scripts/playerctl-read.sh",
        "on-click": "playerctl previous",
        "on-click-middle": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "tooltip": false
    }
}