{
  "positionX": "right",
  "positionY": "bottom",
  "cssPriority": "user",
  "ignore-gtk-theme": true,


  "control-center-width": 360,
  "control-center-margin-top": 15,
  "control-center-margin-bottom": 15,
  "control-center-margin-right": 0,
  "control-center-margin-left": 15,
  "notification-window-width": 360,
  "notification-icon-size": 48,
  "notification-body-image-height": 160,
  "notification-body-image-width": 200,
  "fit-to-screen": true,


  "timeout": 4,
  "timeout-low": 5,
  "timeout-critical": 6,


  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "notification-grouping": true,
  "notification-inline-replies": true,
  "relative-timestamps": true,
  "notification-2fa-action": false,
  "text-empty": "Zzz... (Silence SwayNC is sleeping)",

  "notification-visibility": {
    "spotify-low-muted": {
      "state": "muted",
      "urgency": "Low",
      "app-name": "Spotify"
    }
  },

  "widgets": [
    "label",
    "mpris",
    "volume",
    "title",
    "dnd",
    "notifications"
  ],

  "widget-config": {
    "label": {
      "max-lines": 1,
      "text": "ゴールドシップ は 通知センター を 破壊した ✦"
    },

    "mpris": {
      "image-size": 80,
      "image-radius": 4,
      "blacklist":["playerctld"],
      "loop-carousel": true
    },

    "volume": {
      "label": "󰕾",
      "show-per-app": false,
      "show-per-app-icon": false,
      "show-per-app-label": false,
      "expand-per-app": false,
      "empty-list-label": "No active outputs",
      "animation-type": "slide_down",
      "animation-duration": 200
    },

    "title": {
      "text": "Notification Center",
      "clear-all-button": true,
      "button-text": "Clear All 󰎟 "
    },

    "dnd": {
      "text": "Do not disturb"
    },

    "notifications": {
      "vexpand": true
    }
  }
}